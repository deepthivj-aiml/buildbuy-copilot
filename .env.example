# BuildBuy Copilot — environment variable NAMES only. No values.
# Copy to .env and fill in locally. NEVER commit .env.
APP_ENV=local
DEBUG=false

# Database: SQLite file locally; Postgres URL in deploy.
DATABASE_URL=sqlite:///./data/buildbuy.db

# Email: "mock" (default — nothing real is ever sent) or "smtp".
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=

# The user's own mailbox for summaries / records exports.
USER_EMAIL=deepthiag26@gmail.com

# LLM (optional — backend runs in local-fallback mode without one).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Optional: cache / tracing.
REDIS_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Best-value ranking weights (cost vs evidenced quality vs lead time).
# CANONICAL formula (app/suppliers/search.py): best value =
# 0.45 * cost score + 0.35 * quality score + 0.20 * lead-time score.
# These env values MUST match those weights — do not keep a second formula.
VALUE_WEIGHT_COST=0.45
VALUE_WEIGHT_QUALITY=0.35
VALUE_WEIGHT_LEAD=0.20
